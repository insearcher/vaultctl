{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/insearcher/vaultctl/main/src/vaultctl/schemas/manifest-v1.schema.json",
  "title": "vaultctl manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "apiVersion",
    "vaultId",
    "nodeKinds"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "const": "vaultctl/v1"
    },
    "vaultId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "defaultKind": {
      "type": "string",
      "minLength": 1
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "frontmatter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowLegacyColonScalars": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "search": {
      "$ref": "#/$defs/search"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "nodeKinds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/nodeKind"
      }
    },
    "relations": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "hasField": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "searchZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "weight"
      ],
      "properties": {
        "source": {
          "enum": [
            "title",
            "firstHeading",
            "stem",
            "path",
            "tags",
            "property",
            "properties",
            "headings",
            "body"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "phraseWeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 0
        },
        "countCap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        }
      }
    },
    "searchBoost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weight"
      ],
      "oneOf": [
        {
          "required": [
            "kind"
          ]
        },
        {
          "required": [
            "path"
          ]
        }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/searchZone"
          }
        },
        "boosts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/searchBoost"
          }
        },
        "stopWords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "useDefaultStopWords": {
          "type": "boolean",
          "default": true
        },
        "defaultLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20
        },
        "maxLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 8
        },
        "maxLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20
        },
        "maxCharacters": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1000000,
          "default": 12000
        },
        "snippetLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 2
        },
        "snippetCharacters": {
          "type": "integer",
          "minimum": 32,
          "maximum": 4000,
          "default": 220
        },
        "fallbackToTitle": {
          "type": "boolean",
          "default": true
        },
        "outputFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "grouping": {
          "$ref": "#/$defs/contextGrouping"
        }
      }
    },
    "contextGrouping": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "fields"
          ]
        },
        {
          "required": [
            "pathToken"
          ]
        }
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "pathToken": {
          "const": "ticket"
        },
        "keyCase": {
          "enum": [
            "preserve",
            "upper",
            "lower"
          ],
          "default": "preserve"
        },
        "statusField": {
          "type": "string",
          "minLength": 1,
          "default": "status"
        },
        "inactiveStatuses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "freshnessFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notesPerGroup": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 2
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "object",
            "list"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "nodeKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectors"
      ],
      "properties": {
        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "fields": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "cardinality",
        "targetKinds"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "cardinality": {
          "enum": [
            "0..1",
            "0..*"
          ]
        },
        "targetKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "acyclic": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
